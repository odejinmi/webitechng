            "application/json": {
              "schema": {
                "type": "object",
                "required": ["bank_code", "account_number", "amount", "pin"],
                "properties": {
                  "bank_code": { "type": "string", "example": "011" },
                  "account_number": { "type": "string", "example": "0123456789" },
                  "amount": { "type": "number", "example": 5000 },
                  "pin": { "type": "string", "example": "123456" },
                  "narration": { "type": "string", "example": "Payment for goods" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Transfer processed" } }
      }
    },
    "/user/p2p/transfer": {
      "post": {
        "summary": "Peer to Peer Transfer",
