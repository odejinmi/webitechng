{
  "openapi": "3.0.3",
  "info": {
    "title": "WEBITECHNG API Specification",
    "description": "Comprehensive OpenAPI 3.0 specification for WEBITECHNG Mobile and Merchant APIs with explicit JSON Request Body Payloads.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://your-domain.com/api",
      "description": "Production Server"
    },
    {
      "url": "http://127.0.0.1:8000/api",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/user/register": {
      "post": {
        "summary": "Mobile Signup / Register",
        "description": "Create a new mobile user account. On success, the response contains a Sanctum bearer token and the created user.",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "username", "mobile", "mobile_code", "country_code", "country", "password", "password_confirmation"],
                "properties": {
                  "firstname": { "type": "string", "example": "John" },
                  "lastname": { "type": "string", "example": "Doe" },
                  "email": { "type": "string", "format": "email", "example": "john@example.com" },
                  "username": { "type": "string", "minLength": 6, "example": "johndoe" },
                  "mobile": { "type": "string", "description": "Phone number without the international dial code.", "example": "8012345678" },
                  "mobile_code": { "type": "string", "description": "International dial code selected from the supported country list.", "example": "+234" },
                  "country_code": { "type": "string", "description": "ISO country code selected from the supported country list.", "example": "NG" },
                  "country": { "type": "string", "example": "Nigeria" },
                  "password": { "type": "string", "format": "password", "minLength": 8, "example": "Password123!" },
                  "password_confirmation": { "type": "string", "format": "password", "example": "Password123!" },
                  "ref_by": { "type": "string", "nullable": true, "example": "referrer_user" },
                  "agree": { "type": "boolean", "description": "Required when terms acceptance is enabled by the administrator.", "example": true },
                  "captcha": { "type": "string", "description": "Required only when captcha is enabled.", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "example": {
                  "code": 202,
                  "status": "created",
                  "message": { "success": ["Registration successfull"] },
                  "data": {
                    "access_token": "1|sanctum-token",
                    "token_type": "Bearer",
                    "user": { "id": 123, "username": "johndoe", "email": "john@example.com" }
                  }
                }
              }
            }
          },
          "200": { "description": "Validation failed; inspect message.error" },
          "409": { "description": "Mobile number already exists" },
          "422": { "description": "Invalid request payload" }
        }
      }
    },
    "/user/login": {
      "post": {
        "summary": "Mobile Login",
        "description": "Authenticate with either username or email plus password. Use data.accessToken as the Bearer token for protected endpoints.",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "description": "Username or email address.", "example": "john@example.com" },
                  "password": { "type": "string", "format": "password", "example": "Secret123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "example": {
                  "code": 200,
                  "status": "ok",
                  "message": { "success": ["Login Succesfull"] },
                  "data": {
                    "accessToken": "1|sanctum-token",
                    "token_type": "Bearer",
                    "user": { "id": 123, "username": "johndoe", "email": "john@example.com" }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials or validation failure" },
          "422": { "description": "Invalid request payload" }
        }
      }
    },
    "/user/check-mail": {
      "post": {
        "summary": "Check Email Availability",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "example": "john@example.com" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Email status" } }
      }
    },
    "/user/password/email": {
      "post": {
        "summary": "Send Password Reset Email",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "example": "john@example.com" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Reset email sent" } }
      }
    },
    "/user/password/verify-code": {
      "post": {
        "summary": "Verify Password Reset Code",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code"],
                "properties": {
                  "email": { "type": "string", "example": "john@example.com" },
                  "code": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Code verified" } }
      }
    },
    "/user/password/reset": {
      "post": {
        "summary": "Update Password",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "code", "password", "password_confirmation"],
                "properties": {
                  "email": { "type": "string", "example": "john@example.com" },
                  "code": { "type": "string", "example": "123456" },
                  "password": { "type": "string", "example": "NewPassword123!" },
                  "password_confirmation": { "type": "string", "example": "NewPassword123!" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Password updated" } }
      }
    },
    "/user/verify-email": {
      "post": {
        "summary": "Verify Email",
        "tags": ["Verification"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email_verified_code"],
                "properties": { "email_verified_code": { "type": "string", "example": "123456" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Email verified" } }
      }
    },
    "/user/verify-mobile": {
      "post": {
        "summary": "Verify Mobile SMS",
        "tags": ["Verification"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sms_verified_code"],
                "properties": { "sms_verified_code": { "type": "string", "example": "123456" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Mobile verified" } }
      }
    },
    "/user/verify-g2fa": {
      "post": {
        "summary": "Verify Google 2FA",
        "tags": ["Verification"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "type": "string", "example": "123456" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "2FA verified" } }
      }
    },
    "/user/profile/change-password": {
      "post": {
        "summary": "Change Account Password",
        "tags": ["Profile"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["current_password", "password", "password_confirmation"],
                "properties": {
                  "current_password": { "type": "string", "example": "OldPassword123!" },
                  "password": { "type": "string", "example": "NewPassword123!" },
                  "password_confirmation": { "type": "string", "example": "NewPassword123!" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Password changed" } }
      }
    },
    "/user/deposit/insert": {
      "post": {
        "summary": "Initiate Wallet Deposit",
        "tags": ["Deposits & Withdrawals"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "method_code", "currency"],
                "properties": {
                  "amount": { "type": "number", "example": 5000 },
                  "method_code": { "type": "string", "example": "101" },
                  "currency": { "type": "string", "example": "NGN" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Deposit initiated" } }
      }
    },
    "/user/withdraw": {
      "post": {
        "summary": "Request Withdrawal",
        "tags": ["Deposits & Withdrawals"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["method_code", "amount"],
                "properties": {
                  "method_code": { "type": "string", "example": "1" },
                  "amount": { "type": "number", "example": 10000 }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Withdrawal requested" } }
      }
    },
    "/user/bank/transfer/strowallet": {
      "post": {
        "summary": "Submit Bank Transfer (Strowallet)",
