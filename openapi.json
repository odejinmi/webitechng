          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "amount", "pin"],
                "properties": {
                  "username": { "type": "string", "example": "recipient_user" },
                  "amount": { "type": "number", "example": 2500 },
                  "pin": { "type": "string", "example": "123456" }
