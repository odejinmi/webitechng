        "summary": "Buy Crypto Asset",
        "tags": ["Crypto Services"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["coin_id", "amount", "wallet_address"],
                "properties": {
                  "coin_id": { "type": "string", "example": "BTC" },
                  "amount": { "type": "number", "example": 100 },
                  "wallet_address": { "type": "string", "example": "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Crypto buy order placed" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    }
  }
}
