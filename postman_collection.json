{
  "info": {
    "name": "WEBITECHNG API Collection",
    "description": "Ready-to-import Postman Collection for WEBITECHNG Mobile and Merchant APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe@example.com\",\n  \"password\": \"Secret123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/login",
              "host": ["{{base_url}}"],
              "path": ["user", "login"]
            }
          }
        },
        {
          "name": "User Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"username\": \"johndoe\",\n  \"mobile\": \"08012345678\",\n  \"password\": \"Password123!\",\n  \"password_confirmation\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/register",
              "host": ["{{base_url}}"],
              "path": ["user", "register"]
            }
          }
        },
        {
          "name": "User Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/user/logout",
              "host": ["{{base_url}}"],
              "path": ["user", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "User Core & Dashboard",
      "item": [
        {
          "name": "Get Dashboard Data",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/user/dashboard",
              "host": ["{{base_url}}"],
              "path": ["user", "dashboard"]
            }
          }
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/user/transactions",
              "host": ["{{base_url}}"],
              "path": ["user", "transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "VTU Services",
      "item": [
        {
          "name": "Buy Airtime",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operator\": \"123\",\n  \"amount\": 1000,\n  \"phone\": \"08012345678\",\n  \"wallet\": \"main\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/airtime/buy/airtime",
              "host": ["{{base_url}}"],
              "path": ["user", "airtime", "buy", "airtime"]
            }
          }
        },
        {
          "name": "Buy Internet Data",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operator\": \"mtn\",\n  \"plan\": \"500MB\",\n  \"phone\": \"08012345678\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/internet/buy/internet",
              "host": ["{{base_url}}"],
              "path": ["user", "internet", "buy", "internet"]
            }
          }
        }
      ]
    },
    {
      "name": "Financial Services",
      "item": [
        {
          "name": "Bank Transfer (Strowallet)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearer_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank_code\": \"011\",\n  \"account_number\": \"0123456789\",\n  \"amount\": 5000,\n  \"pin\": \"1234\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user/bank/transfer/strowallet",
              "host": ["{{base_url}}"],
              "path": ["user", "bank", "transfer", "strowallet"]
            }
          }
        }
      ]
    }
  ]
}
